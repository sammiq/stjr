# TREKJR.MAK - rebuild TREKJR.EXE with Microsoft C/C++ 7.00, MASM 5.0 and
# C 7.00's LINK, the way the original was built.
#
#   NMAKE /F TREKJR.MAK            (NMAKE /A /F TREKJR.MAK rebuilds everything)
#
# Run under DOS with the project root as the current drive, so that the
# compilers are \TOOLS\C700 and \TOOLS\MASM50 (tools/dosbuild.py runs the
# link the same way under dosemu2). Objects and the EXE go to BUILD\DOS.
# C 7.00's compiler passes need a DPMI host: dosemu2, a Windows 3.x DOS box
# or 386-MAX.
# Set the compiler's environment first:
#   SET PATH=\TOOLS\C700\BIN
#   SET INCLUDE=\TOOLS\C700\INCLUDE

O       = BUILD\DOS
CC      = \TOOLS\C700\BIN\CL
AS      = \TOOLS\MASM50\BIN\MASM
LINK    = \TOOLS\C700\BIN\LINK

CFLAGS  = /c /nologo /AM /G2 /Ox /FPa /Zp1 /W3 /I\INCLUDE
AFLAGS  = /Ml /t

H       = INCLUDE\ACTOR.H INCLUDE\BITMAP.H INCLUDE\CACHE.H INCLUDE\EMS.H \
          INCLUDE\EVENT.H INCLUDE\FIXMATH.H INCLUDE\GFX.H INCLUDE\LIST.H \
          INCLUDE\MEM.H INCLUDE\MENU.H INCLUDE\OBJ3D.H INCLUDE\RESOURCE.H \
          INCLUDE\ROOM.H INCLUDE\SOUND.H INCLUDE\SPRITE.H

# Link order: the game's files in the original's code order (it puts seg019
# after seg006, and the assembly modules among the C files as they were).
# BSS.OBJ (generated by tools/genbss.py) pins the communals to their
# original addresses; it must be the last object.
OBJS1   = $O\SEG000.OBJ $O\SEG001.OBJ $O\SEG002.OBJ $O\SEG003.OBJ $O\SEG004.OBJ \
          $O\SEG005.OBJ $O\SEG006.OBJ $O\SEG019.OBJ $O\SEG007.OBJ $O\SEG008.OBJ \
          $O\SEG009.OBJ $O\SEG010.OBJ $O\SEG011.OBJ $O\SEG012.OBJ $O\SEG013.OBJ \
          $O\SEG014.OBJ $O\SEG015.OBJ $O\SEG016.OBJ
OBJS2   = $O\SEG020.OBJ $O\SEG021.OBJ $O\SEG022.OBJ $O\SEG023.OBJ $O\SEG024.OBJ \
          $O\SEG025.OBJ $O\SEG027.OBJ $O\DEMO.OBJ $O\SPACE.OBJ $O\SEG017.OBJ \
          $O\T2D688.OBJ $O\IFF.OBJ $O\CFG.OBJ $O\ACMP.OBJ $O\SEG028.OBJ \
          $O\MVELIB.OBJ $O\BSS.OBJ
# The medium model, alternate math library (/FPa) that C 7.00's SETUP builds
# when alternate math is chosen, and the old names (stricmp, lseek, ...).
LIBS    = \TOOLS\C700\LIB\MLIBCA.LIB+\TOOLS\C700\LIB\OLDNAMES.LIB

$O\TREKJR.EXE: $(OBJS1) $(OBJS2)
        $(LINK) /NOLOGO /NOI /NOD /EXEPACK /PACKCODE /FARCALLTRANSLATION /MAP /STACK:0x12E8 @<<
$O\SEG000.OBJ+
$O\SEG001.OBJ+
$O\SEG002.OBJ+
$O\SEG003.OBJ+
$O\SEG004.OBJ+
$O\SEG005.OBJ+
$O\SEG006.OBJ+
$O\SEG019.OBJ+
$O\SEG007.OBJ+
$O\SEG008.OBJ+
$O\SEG009.OBJ+
$O\SEG010.OBJ+
$O\SEG011.OBJ+
$O\SEG012.OBJ+
$O\SEG013.OBJ+
$O\SEG014.OBJ+
$O\SEG015.OBJ+
$O\SEG016.OBJ+
$O\SEG020.OBJ+
$O\SEG021.OBJ+
$O\SEG022.OBJ+
$O\SEG023.OBJ+
$O\SEG024.OBJ+
$O\SEG025.OBJ+
$O\SEG027.OBJ+
$O\DEMO.OBJ+
$O\SPACE.OBJ+
$O\SEG017.OBJ+
$O\T2D688.OBJ+
$O\IFF.OBJ+
$O\CFG.OBJ+
$O\ACMP.OBJ+
$O\SEG028.OBJ+
$O\MVELIB.OBJ+
$O\BSS.OBJ
$@
$O\TREKJR.MAP
$(LIBS);
<<

$O\SEG000.OBJ: SRC\SEG000.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\SEG000.C

$O\SEG001.OBJ: SRC\SEG001.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\SEG001.C

$O\SEG002.OBJ: SRC\SEG002.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\SEG002.C

$O\SEG003.OBJ: SRC\SEG003.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\SEG003.C

$O\SEG004.OBJ: SRC\SEG004.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\SEG004.C

$O\SEG005.OBJ: SRC\SEG005.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\SEG005.C

$O\SEG006.OBJ: SRC\SEG006.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\SEG006.C

$O\SEG019.OBJ: SRC\SEG019.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\SEG019.C

$O\SEG007.OBJ: SRC\SEG007.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\SEG007.C

$O\SEG008.OBJ: SRC\SEG008.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\SEG008.C

$O\SEG009.OBJ: SRC\SEG009.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\SEG009.C

$O\SEG010.OBJ: SRC\SEG010.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\SEG010.C

$O\SEG011.OBJ: SRC\SEG011.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\SEG011.C

$O\SEG012.OBJ: SRC\SEG012.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\SEG012.C

$O\SEG013.OBJ: SRC\SEG013.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\SEG013.C

$O\SEG014.OBJ: SRC\SEG014.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\SEG014.C

$O\SEG015.OBJ: SRC\SEG015.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\SEG015.C

$O\SEG016.OBJ: SRC\SEG016.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\SEG016.C

$O\SEG020.OBJ: SRC\SEG020.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\SEG020.C

$O\SEG021.OBJ: SRC\SEG021.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\SEG021.C

$O\SEG022.OBJ: SRC\SEG022.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\SEG022.C

$O\SEG023.OBJ: SRC\SEG023.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\SEG023.C

$O\SEG024.OBJ: SRC\SEG024.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\SEG024.C

$O\SEG025.OBJ: SRC\SEG025.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\SEG025.C

$O\SEG027.OBJ: SRC\SEG027.ASM
        $(AS) $(AFLAGS) SRC\SEG027.ASM,$@;

$O\DEMO.OBJ: SRC\DEMO.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\DEMO.C

$O\SPACE.OBJ: SRC\SPACE.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\SPACE.C

$O\SEG017.OBJ: SRC\SEG017.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\SEG017.C

$O\T2D688.OBJ: SRC\ASM\T2D688.ASM
        $(AS) $(AFLAGS) SRC\ASM\T2D688.ASM,$@;

$O\IFF.OBJ: SRC\IFF.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\IFF.C

$O\CFG.OBJ: SRC\CFG.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\CFG.C

$O\ACMP.OBJ: SRC\ACMP.C $(H)
        $(CC) $(CFLAGS) /Fo$@ SRC\ACMP.C

$O\SEG028.OBJ: SRC\SEG028.ASM
        $(AS) $(AFLAGS) SRC\SEG028.ASM,$@;

$O\MVELIB.OBJ: SRC\MVELIB.ASM
        $(AS) $(AFLAGS) SRC\MVELIB.ASM,$@;

$O\BSS.OBJ: SRC\BSS.ASM
        $(AS) $(AFLAGS) SRC\BSS.ASM,$@;
